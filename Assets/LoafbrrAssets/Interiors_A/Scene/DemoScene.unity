  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "U svibnju 1995. Hrvatska vojska pokre\u0107e operaciju \u201EBljesak\u201C,
    a u kolovozu operaciju \u201EOluja\u201C,\r\nkojom je oslobo\u0111en najve\u0107i
    dio okupiranog teritorija. Time je slomljena srpska paradr\u017Eava\r\nRepublika
    Srpska Krajina. Nakon pobjede uslijedile su operacije u Bosni i Hercegovini koje\r\nsu
    doprinijele zavr\u0161etku rata. Oluju mo\u017Eemo smatrati kona\u010Dnom pobjedom
    Hrvatske u\r\nDomovinskom ratu. U prosincu 1995. potpisan je Daytonski sporazum,
    a mirna reintegracija\r\nPodunavlja zavr\u0161ila je 1998. godine."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
