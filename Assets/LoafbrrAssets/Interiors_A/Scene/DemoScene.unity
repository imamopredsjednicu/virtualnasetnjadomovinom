  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Bitka za Vukovar simbol je otpora i \u017Ertve Vukovaraca, ali i svih
    Hrvata. Grad na Dunavu,\r\nokru\u017Een tisu\u0107ama vojnika JNA i srpskih paravojnih
    postrojbi, odolijevao je gotovo tri mjeseca.\r\nBranitelji, njih oko 1800, suprotstavili
    su se vi\u0161estruko nadmo\u0107nijem neprijatelju. Vukovar je\r\nrazoren, a
    nakon njegova pada 18. studenoga 1991. uslijedili su masovni zlo\u010Dini i progon\r\ncivilnog
    stanovni\u0161tva. Vukovar je postao temelj nacionalnog identiteta tijekom Domovinskog\r\nrata."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
